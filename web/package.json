{
  "$schema": "https://json.schemastore.org/package.json",
  "dependencies": {
    "@ptb/vite-config": "2024.6.24",
    "@vitejs/plugin-react": "4.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vike": "0.4.177",
    "vike-react": "0.4.14",
    "vite": "5.3.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.44.1",
    "@ptb/playwright-config": "2024.6.24",
    "@ptb/test": "2024.6.24",
    "@ptb/typescript-config": "2024.6.24",
    "@types/node": "20.14.8",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "typescript": "5.5.2",
    "vitest": "1.6.0",
    "vitest-monocart-coverage": "1.1.2"
  },
  "private": true,
  "scripts": {
    "build": "vite build --mode release",
    "check:type": "tsc --noEmit --project tsconfig.json --skipLibCheck",
    "serve": "vite preview",
    "start": "vite dev",
    "test": "pnpm test:unit; pnpm test:test; pnpm test:spec",
    "test:spec": "TYPE=spec playwright test",
    "test:test": "TYPE=test playwright test",
    "test:unit": "TYPE=unit vitest run"
  },
  "type": "module"
}
