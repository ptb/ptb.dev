{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "extends": "@ptb/typescript-config",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "${configDir}/*.cjs",
    "${configDir}/src",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
