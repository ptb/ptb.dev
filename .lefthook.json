{
  "output": [
    "summary"
  ],
  "pre-commit": {
    "commands": {
      "check:lint": {
        "glob": "*.{cjs,js,jsx,mjs,ts,tsx}",
        "run": "pnpm check:lint {staged_files}"
      },
      "check:tidy": {
        "glob": "*.{cjs,js,jsx,mjs,ts,tsx}",
        "run": "pnpm check:tidy {staged_files}"
      },
      "check:type": {
        "glob": "*.{ts,tsx}",
        "run": "pnpm check:type"
      }
    },
    "parallel": true
  }
}
