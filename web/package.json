{
  "$schema": "https://json.schemastore.org/package.json",
  "babelMacros": {
    "@ptb/style": {
      "output": "public/styles.css"
    }
  },
  "dependencies": {
    "@ptb/style": "1.0.0",
    "@ptb/vite-config": "2024.7.1",
    "@vitejs/plugin-react": "4.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vike": "0.4.177",
    "vike-react": "0.4.15",
    "vite": "5.3.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "1.6.0",
    "@playwright/experimental-ct-react": "1.45.0",
    "@ptb/playwright-config": "2024.7.1",
    "@ptb/test": "2024.7.1",
    "@ptb/typescript-config": "2024.7.1",
    "@storybook/addon-essentials": "8.1.11",
    "@storybook/addon-interactions": "8.1.11",
    "@storybook/addon-links": "8.1.11",
    "@storybook/addon-onboarding": "8.1.11",
    "@storybook/blocks": "8.1.11",
    "@storybook/react": "8.1.11",
    "@storybook/react-vite": "8.1.11",
    "@storybook/test": "8.1.11",
    "@storybook/types": "8.1.11",
    "@types/node": "20.14.9",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "storybook": "8.1.11",
    "typescript": "5.5.2",
    "vitest": "1.6.0",
    "vitest-monocart-coverage": "1.1.2"
  },
  "private": true,
  "scripts": {
    "build": "vite build --mode release",
    "check:type": "tsc --noEmit --project tsconfig.json --skipLibCheck",
    "serve": "vite preview",
    "start": "vite dev",
    "storybook:build": "TYPE=test storybook build -c .sb -o .sb/www",
    "storybook:start": "TYPE=test storybook dev -c .sb -p 6006",
    "test": "pnpm test:unit; pnpm test:test; pnpm test:spec",
    "test:spec": "TYPE=spec playwright test",
    "test:test": "TYPE=test playwright test",
    "test:unit": "TYPE=unit vitest run"
  },
  "type": "module"
}
